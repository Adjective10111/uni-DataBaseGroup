CRATE TABLE PARTICIPATE(
Tsn varchar(10) NOT NULL UNIQUE,
Lsn varchar(10) NOT NULL UNIQUE,


CONSTRAINT PARTICIPATE_PK PRIMARY KEY (Tsn)
CONSTRAINT PARTICIPATE_PK PRIMARY KEY (Lsn)

 FOREIGN KEY (Tsn) REFERENCES TEAM(Serial_no)
  FOREIGN KEY (Lsn) REFERENCES LEAGE(Serial_no)
)

CRATE TABLE PLAYER (
National_code varchar(10) NOT NULL UNIQUE,
Height varchar(10) NOT NULL,
Weight varchar(10) NOT NULL,

CONSTRAINT PLAYER_PK PRIMARY KEY (National_code)
 FOREIGN KEY (National_code) REFERENCES PERSON(National_code)


)

CRATE TABLE TECHNICAL_STAF (
National_code varchar(10) NOT NULL UNIQUE,


CONSTRAINT TECHNICAL_STAF_PK PRIMARY KEY (National_code)
 FOREIGN KEY (National_code) REFERENCES PERSON(National_code)
)

CRATE TABLE TEAM(
National_code varchar(10) NOT NULL UNIQUE,
Name varchar(10) NOT NULL,
City varchar(10) NOT NULL,
Established_year varchar(10) NOT NULL,

CONSTRAINT TEAM_PK PRIMARY KEY (National_code)
)

CRATE TABLE LEAGE(
Serial_no varchar(10) NOT NULL UNIQUE,
Name varchar(10) NOT NULL,
Champion varchar(10) NOT NULL,


CONSTRAINT LEAGE_PK PRIMARY KEY (Serial_no)
 FOREIGN KEY (Champion) REFERENCES TEAM(Serial_no)
)
